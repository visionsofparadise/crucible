{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows / Ninja / cl.exe / Debug",
      "description": "Run from a 'Developer Command Prompt for VS 2026' (or after vcvarsall.bat x64) so cl.exe and the Windows SDK are on PATH. Requires ninja (winget install Ninja-build.Ninja).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CRUCIBLE_UI_DEV_SERVER": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows / Ninja / cl.exe / Release",
      "description": "Run from a 'Developer Command Prompt for VS 2026' (or after vcvarsall.bat x64). Requires ninja (winget install Ninja-build.Ninja).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MAKE_PROGRAM": "ninja",
        "CRUCIBLE_UI_DEV_SERVER": "OFF"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS / Ninja / Clang / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CRUCIBLE_UI_DEV_SERVER": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS / Ninja / Clang / Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CRUCIBLE_UI_DEV_SERVER": "OFF"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux / Ninja / Clang / Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CRUCIBLE_UI_DEV_SERVER": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux / Ninja / Clang / Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CRUCIBLE_UI_DEV_SERVER": "OFF"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug",   "configurePreset": "windows-debug",   "configuration": "Debug"   },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "macos-debug",     "configurePreset": "macos-debug",     "configuration": "Debug"   },
    { "name": "macos-release",   "configurePreset": "macos-release",   "configuration": "Release" },
    { "name": "linux-debug",     "configurePreset": "linux-debug",     "configuration": "Debug"   },
    { "name": "linux-release",   "configurePreset": "linux-release",   "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "default-test",
      "description": "Run Catch2 tests against the host's release build directory.",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "stopOnFailure": false },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "default-test-macos",
      "configurePreset": "macos-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "default-test-linux",
      "configurePreset": "linux-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ]
}
