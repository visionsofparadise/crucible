{
	"name": "crucible-ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "node -e \"import('node:child_process').then(({execSync})=>{try{execSync('git rev-parse --is-inside-work-tree',{stdio:'ignore'});execSync('git config core.hooksPath .githooks')}catch{}})\" && node ../tools.mjs install",
		"start": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"eslint . --fix --cache\" \"stylelint \\\"**/*.css\\\" --fix --allow-empty-input --cache\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\" \"textlint --fix \\\"**/*.md\\\"\"",
		"check": "concurrently --group \"prettier --check .\" \"eslint . --no-cache -f unix\" \"tsc --noEmit --pretty false\" \"stylelint \\\"**/*.css\\\" -f unix --allow-empty-input --cache\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint -f compact \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\" \"node ../tools.mjs run actionlint\"",
		"unit": "vitest run unit"
	},
	"dependencies": {
		"@codemirror/lang-cpp": "^6.0.3",
		"@codemirror/language": "^6.10.3",
		"@codemirror/lint": "^6.8.4",
		"@codemirror/state": "^6.4.1",
		"@codemirror/view": "^6.34.1",
		"@fontsource/azeret-mono": "^5.2.11",
		"@fontsource/doto": "^5.2.10",
		"@fontsource/pirata-one": "^5.2.8",
		"@lezer/highlight": "^1.2.1",
		"@uiw/react-codemirror": "^4.25.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"juce-framework-frontend": "file:./vendor/juce-framework-frontend",
		"lucide-react": "^0.460.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^2.5.5"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/compat": "^1.3.2",
		"@eslint/js": "^9.17.0",
		"@html-eslint/eslint-plugin": "^0.65.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.0.2",
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^9.1.0",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-formatter-unix": "^9.0.1",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-barrel-files": "^3.0.1",
		"eslint-plugin-comment-rules": "^0.1.7",
		"eslint-plugin-import-x": "^4.6.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.3",
		"eslint-plugin-react-hooks": "^5.1.0",
		"globals": "^15.14.0",
		"jscpd": "^5.0.12",
		"knip": "^6.29.0",
		"markdownlint-cli2": "^0.23.1",
		"prettier": "^3.6.2",
		"stylelint": "^16.26.0",
		"stylelint-config-recommended": "^17.0.0",
		"tailwindcss": "^4.0.0",
		"textlint": "^15.2.2",
		"textlint-filter-rule-comments": "^1.2.2",
		"textlint-rule-no-dead-link": "^6.2.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.2",
		"vite": "^6.0.7",
		"vitest": "^2.1.8"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"esbuild@0.21.5": true,
		"unrs-resolver@1.11.1": true
	}
}
